VISIONKIT_DB_PATH=../data/visionkit.sqlite3
VISIONKIT_SOURCES_PATH=../data/sources
VISIONKIT_CORS_ORIGINS=http://localhost:3001,http://localhost:3000

VISIONKIT_MAX_VIDEO_UPLOAD_MB=200

VISIONKIT_MODELS_PATH=../data/models

VISIONKIT_MAX_MODEL_UPLOAD_MB=200

VISIONKIT_AI_URL=http://127.0.0.1:8001

VISIONKIT_RUNS_PATH=../data/runs

# Internal MediaMTX endpoints (set automatically by ./dev.py)
VISIONKIT_MEDIAMTX_API_URL=http://127.0.0.1:9997
VISIONKIT_MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
VISIONKIT_MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554
# If using Docker Compose outside ./dev.py, map cameras hosted on this machine:
# VISIONKIT_MEDIAMTX_SOURCE_HOST=host.docker.internal
